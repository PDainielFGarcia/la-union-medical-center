# Dependencies
node_modules/
backend/vendor/

# Environment & secrets (never commit)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Logs & caches
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
!backend/storage/framework/**/.gitignore
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore

# Build / tooling outputs (keep production SPA under backend/public/spa committed for XAMPP deploys)
dist/
dist-ssr/
backend/public/hot
backend/public/storage

# Backups & local reports generated at runtime
backend/storage/app/backups/*
!backend/storage/app/backups/.gitignore
backend/storage/app/reports/*
!backend/storage/app/reports/.gitignore

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# PHP / test
.phpunit.result.cache
backend/.phpunit.cache
_ide_helper.php
