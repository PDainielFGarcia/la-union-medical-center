APP_NAME="LUMC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lumc
DB_USERNAME=root
DB_PASSWORD=

# Dev: Vite origin. Production (same host): set to your public URL or leave blank.
FRONTEND_URL=http://localhost:5173

# Production checklist (hospital PC / WAMP vhost):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=http://lumc.local
# FRONTEND_URL=http://lumc.local
# LOG_LEVEL=error
# Then: php artisan key:generate
#       php artisan migrate --force
#       php artisan db:seed --class=ProductionBootstrapSeeder --force
#       php artisan config:cache && php artisan route:cache && php artisan optimize
# Build SPA: from repo root → npm run build  (outputs to public/spa)
# ProductionBootstrapSeeder = catalogs + admin only.
# Do NOT run default DatabaseSeeder (demo staff/patients) on a live hospital database.

BACKUP_MYSQLDUMP_PATH=C:/wamp64/bin/mysql/mysql9.1.0/bin/mysqldump.exe
BACKUP_OFFSITE_PATH=
BACKUP_TIME=02:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@hospital.local"
MAIL_FROM_NAME="${APP_NAME}"
